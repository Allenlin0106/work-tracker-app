# 使用 Node 20 版本，兼顧輕量與穩定性
FROM node:20-alpine

# 安裝 Java 21 (Firebase 模擬器運作的必要依賴)
# 新增 curl：用於透過 REST API 穩定地執行定時存檔，避免 CLI 指令衝突
RUN apk add --no-cache openjdk21-jre-headless curl

# 安裝 Firebase CLI 工具
RUN npm install -g firebase-tools

WORKDIR /app

# 1. 複製模擬器核心設定檔與規則
COPY firebase.json .
COPY database.rules .

# 2. 複製關鍵的存檔控制腳本
COPY entrypoint.sh .

# 3. 修正權限與格式：
#    - chmod +x: 賦予執行權限
#    - sed -i: 自動將 Windows 的 \r\n 換行格式轉為 Linux 的 \n
RUN chmod +x entrypoint.sh && \
    sed -i 's/\r$//' entrypoint.sh

# 4. 預先建立存檔目錄，確保掛載卷（Volumes）權限正確
RUN mkdir -p /app/data/export

# 曝露所有必要的模擬器埠口
EXPOSE 4000 8181 9099 9150

# 5. 使用 ENTRYPOINT 啟動腳本
ENTRYPOINT ["./entrypoint.sh"]