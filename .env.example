# 複製此檔案為 .env 並依下方說明填入值（.env 不進 git）

# ── 敏感憑證（AES-256-CBC 加密密文，使用 scripts/encrypt-secret.js 產生）──
# 首次部署步驟：
#   node scripts/encrypt-secret.js   ← 加密 SQL 密碼，複製輸出填入下方
#   node scripts/encrypt-secret.js   ← 再次執行，加密 JWT 金鑰，填入下方
#   chmod 400 secrets/encryption_key.txt
ENCRYPTED_SQL_PASSWORD=
ENCRYPTED_JWT_SECRET=

# ── SQL Server 連線（非敏感，明文即可）──
SQL_SERVER=192.168.146.10     # SQL Server 主機 IP 或 hostname
SQL_PORT=1433
SQL_DATABASE=worktracker      # 需事先在 SQL Server 建立此資料庫
SQL_USER=wt_user
SQL_ENCRYPT=false             # 內網無 TLS 設 false；Azure 或雲端設 true
SQL_TRUST_CERT=true           # 使用自簽憑證時設 true

# ── HTTPS 前端位址（用於 CORS 白名單）──
CORS_ORIGIN=https://192.168.146.160:8088

# ── 本機開發 fallback（不建立 secrets/ 目錄時使用，正式環境請刪除）──
# SQL_PASSWORD=明文密碼
# JWT_SECRET=明文JWT金鑰
