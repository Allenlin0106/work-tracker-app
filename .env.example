# 複製此檔案為 .env 並填入實際值（.env 不進 git）

# MongoDB 連線字串（依實際環境調整）
# 內網無 TLS：mongodb://user:pass@192.168.146.10:27017/worktracker?authSource=admin
# 雲端 Atlas：mongodb+srv://user:pass@cluster0.xxx.mongodb.net/worktracker?retryWrites=true&w=majority
# 跨網段 TLS：mongodb://user:pass@db.example.com:27017/worktracker?tls=true&authSource=admin
MONGO_URI=

# JWT 簽名金鑰（建議 32 字元以上隨機字串）
JWT_SECRET=

# HTTPS 前端位址（用於 CORS 白名單，改為實際主機 IP）
CORS_ORIGIN=https://192.168.146.160:8088
