# 複製此檔案為 .env 並填入實際值（.env 不進 git）
# 後端啟動時會驗證 JWT_SECRET / CORS_ORIGIN / MONGO_URI 必須存在，缺失或 JWT_SECRET <32 字元即拒絕啟動。

# MongoDB root 帳密（mongo 容器初始化時建立、被 backend MONGO_URI 引用）
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=請改為強密碼

# 後端連線字串：docker-compose 會自動由 MONGO_ROOT_USER / MONGO_ROOT_PASS 組合並傳入 backend 容器。
# 若改為本地直接 `node server/index.js`，請於此手動填入完整連線字串。
# MONGO_URI=mongodb://admin:password@127.0.0.1:27017/worktracker?authSource=admin

# JWT 簽名金鑰；長度至少 32 字元，建議使用 `openssl rand -base64 48` 產生
JWT_SECRET=請改為至少32字元的隨機字串請改為至少32字元的隨機字串

# HTTPS 前端位址（用於 CORS 白名單，改為實際主機 IP）
CORS_ORIGIN=https://192.168.146.160:8088
