@* MainPage — 主應用介面，對應 React App.jsx 的 ready 狀態渲染 *@

<div class="min-h-screen bg-[#F8FAFC] text-slate-900 flex flex-col font-sans">

    @* ── Header ─────────────────────────────────────────────────────────────── *@
    <header class="bg-white/80 backdrop-blur-md border-b border-slate-200 h-16 flex items-center justify-between px-6 sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="bg-indigo-600 p-2 rounded-xl text-white shadow-lg">
                <LucideIcon Name="layout-dashboard" Class="w-5 h-5" />
            </div>
            <h1 class="text-2xl font-black text-indigo-600 uppercase tracking-tight">Progress Hub</h1>
        </div>
        <div class="flex items-center gap-4">
            <div class="flex bg-slate-100 p-1.5 rounded-xl shadow-inner border border-slate-200">
                @foreach (var m in new[] { ("list","列表"), ("gantt","甘特圖"), ("weekly","週報"), ("monthly","月報") })
                {
                    var (mode, label) = m;
                    <button @onclick="() => { _viewMode = mode; _filters.Statuses.Clear(); }"
                            class="px-6 py-2 rounded-lg text-base font-bold transition-all @(_viewMode == mode ? "bg-white shadow-sm text-indigo-600" : "text-slate-500 hover:text-slate-700")">
                        @label
                    </button>
                }
            </div>
            <button @onclick="OpenCreateTask"
                    class="bg-slate-900 text-white px-6 py-2.5 rounded-xl text-base font-bold shadow-lg flex items-center gap-2 active:scale-95 transition-all">
                <LucideIcon Name="plus" Class="w-5 h-5" /> 建立任務
            </button>
            <button @onclick="HandleLogout" title="登出"
                    class="flex items-center gap-1.5 text-slate-500 hover:text-red-500 hover:bg-red-50 transition-colors px-3 py-2 rounded-xl text-sm font-bold">
                <LucideIcon Name="user" Class="w-4 h-4" /> @Auth.Username
            </button>
        </div>
    </header>

    <main class="flex-1 p-4 md:p-8 max-w-[1600px] mx-auto w-full flex flex-col overflow-hidden">

        @* ── Filter panel ───────────────────────────────────────────────────── *@
        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-8 mb-8">
            <div class="flex items-center gap-4">
                <div class="flex items-center bg-slate-50 border border-slate-200 rounded-2xl px-6 py-4 shadow-inner flex-1">
                    <LucideIcon Name="search" Class="w-6 h-6 text-slate-300 mr-3" />
                    <input type="text" placeholder="搜尋項目標題或標籤名稱..."
                           class="bg-transparent text-base font-bold outline-none w-full text-slate-700"
                           value="@_searchTerm"
                           @oninput="e => _searchTerm = e.Value?.ToString() ?? string.Empty" />
                </div>
                @if (_viewMode == "gantt")
                {
                    <div class="flex bg-slate-100 p-2 rounded-2xl shadow-inner border border-slate-200">
                        @foreach (var (s, lbl) in new[] { ("day","日"), ("week","週"), ("month","月") })
                        {
                            <button @onclick="() => _ganttScale = s"
                                    class="px-4 py-1.5 rounded-xl text-sm font-black transition-all @(_ganttScale == s ? "bg-white text-indigo-600 shadow-md" : "text-slate-500")">
                                @lbl
                            </button>
                        }
                    </div>
                }
                <div class="flex items-center gap-2">
                    <button @onclick="() => _isManagingTags = true"
                            class="p-4 bg-slate-50 border border-slate-200 rounded-2xl text-slate-400 hover:text-indigo-600 transition-all shadow-sm" title="標籤管理">
                        <LucideIcon Name="tag" Class="w-6 h-6" />
                    </button>
                    <button @onclick="() => _isManagingGroups = true"
                            class="p-4 bg-slate-50 border border-slate-200 rounded-2xl text-slate-400 hover:text-indigo-600 transition-all shadow-sm" title="小組管理">
                        <LucideIcon Name="settings-2" Class="w-6 h-6" />
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                @* Groups *@
                <div class="space-y-4">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                        <LucideIcon Name="layers" Class="w-4 h-4" /> 執行小組
                    </p>
                    <div class="flex flex-wrap gap-3">
                        @foreach (var g in AppState.Groups)
                        {
                            <FilterChip Label="@g.Name" IsActive="@_filters.Groups.Contains(g.Name)"
                                        OnClick="@(() => ToggleFilter("groups", g.Name))"
                                        ActiveClass="@(g.Color?.Active ?? "bg-indigo-600")"
                                        UnselectedClass="@($"{g.Color?.Bg ?? "bg-slate-50"} {g.Color?.Text ?? "text-slate-500"} border-transparent shadow-sm")" />
                        }
                    </div>
                </div>

                @* Tags *@
                <div class="space-y-4 border-l border-slate-100 px-0 lg:px-8">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                        <LucideIcon Name="tag" Class="w-4 h-4" /> 專案標籤
                    </p>
                    @if (ActiveTags.Any())
                    {
                        <div class="flex flex-wrap gap-3">
                            @foreach (var t in ActiveTags)
                            {
                                <FilterChip Label="@t.Name" IsActive="@_filters.Tags.Contains(t.Name)"
                                            OnClick="@(() => ToggleFilter("tags", t.Name))"
                                            ActiveClass="@(t.Color?.Active ?? "bg-indigo-600")"
                                            UnselectedClass="@($"{t.Color?.Bg ?? "bg-slate-50"} {t.Color?.Text ?? "text-slate-500"} border-transparent shadow-sm")" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-sm font-bold text-slate-300 italic py-1">目前無進行中標籤</div>
                    }
                    @if (CompletedTags.Any())
                    {
                        <div class="space-y-3 pt-3 border-t border-slate-100">
                            <p class="text-[10px] font-black text-emerald-500 uppercase tracking-widest flex items-center gap-1.5">
                                <LucideIcon Name="check-circle-2" Class="w-3 h-3" /> 已完成專案標籤
                            </p>
                            <div class="flex flex-wrap gap-2 opacity-60 hover:opacity-100 transition-opacity">
                                @foreach (var t in CompletedTags)
                                {
                                    <FilterChip Label="@t.Name" IsActive="@_filters.Tags.Contains(t.Name)"
                                                OnClick="@(() => ToggleFilter("tags", t.Name))"
                                                ActiveClass="@(t.Color?.Active ?? "bg-indigo-600")"
                                                UnselectedClass="@($"{t.Color?.Bg ?? "bg-slate-50"} {t.Color?.Text ?? "text-slate-500"} border-transparent shadow-sm")" />
                                }
                            </div>
                        </div>
                    }
                </div>

                @* Assignees *@
                <div class="space-y-4 border-l border-slate-100 px-0 lg:px-8">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                        <LucideIcon Name="user" Class="w-4 h-4" /> 負責人員
                    </p>
                    <div class="flex flex-wrap gap-3">
                        @foreach (var name in AllUniqueAssignees)
                        {
                            <FilterChip Label="@name" IsActive="@_filters.Assignees.Contains(name)"
                                        OnClick="@(() => ToggleFilter("assignees", name))"
                                        ActiveClass="bg-teal-600"
                                        UnselectedClass="bg-slate-50 text-slate-500 border-transparent shadow-sm" />
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Stats dashboard ─────────────────────────────────────────────────── *@
        @{
            var stats = Stats;
            var statusCards = new[]
            {
                ("todo",    "未開始", "bg-slate-600",   "clock"),
                ("doing",   "進行中", "bg-blue-600",    "alert-circle"),
                ("done",    "已完成", "bg-emerald-600", "check-circle-2"),
                ("delayed", "已逾期", "bg-rose-600",    "alert-triangle"),
            };
            int statCount(string v) => v switch { "todo" => stats.Todo, "doing" => stats.Doing, "done" => stats.Done, _ => stats.Delayed };
        }
        <div class="grid grid-cols-2 md:grid-cols-5 gap-6 mb-10">
            <button @onclick="() => _filters.Statuses.Clear()"
                    class="p-6 rounded-3xl border transition-all flex items-center gap-4 text-left hover:scale-105 active:scale-95 @(_filters.Statuses.Count == 0 ? "bg-white border-indigo-600 shadow-xl ring-4 ring-indigo-50 shadow-slate-200/50" : "bg-white/50 border-slate-200 shadow-sm opacity-70")">
                <div class="p-3 rounded-2xl transition-colors @(_filters.Statuses.Count == 0 ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-400")">
                    <LucideIcon Name="activity" Class="w-6 h-6" />
                </div>
                <div>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">@(_viewMode is "list" or "gantt" ? "全部任務" : "時段內活動")</p>
                    <p class="text-2xl font-black">@stats.Total</p>
                </div>
            </button>
            @foreach (var (val, lbl, activeColor, icon) in statusCards)
            {
                bool isActive = _filters.Statuses.Contains(val);
                <button @onclick='() => ToggleFilter("statuses", val)'
                        class="p-6 rounded-3xl border transition-all flex items-center gap-4 text-left hover:scale-105 active:scale-95 @(isActive ? "bg-white border-indigo-600 shadow-xl ring-4 ring-indigo-50 shadow-slate-200/50" : "bg-white/50 border-slate-200 shadow-sm opacity-70")">
                    <div class="p-3 rounded-2xl @(isActive ? activeColor + " text-white" : "bg-slate-100 text-slate-400")">
                        <LucideIcon Name="@icon" Class="w-6 h-6" />
                    </div>
                    <div>
                        <p class="text-xs font-black text-slate-400 uppercase tracking-widest">@lbl</p>
                        <p class="text-2xl font-black">@statCount(val)</p>
                    </div>
                </button>
            }
        </div>

        @* ── Main content area ───────────────────────────────────────────────── *@
        <div class="flex-1 bg-white border border-slate-200 rounded-[2.5rem] overflow-hidden shadow-xl flex flex-col relative shadow-slate-200/50">

            @* List view *@
            @if (_viewMode == "list")
            {
                <div class="overflow-auto flex-1 scrollbar-thin">
                    <table class="w-full text-left border-separate border-spacing-0">
                        <thead class="bg-slate-50 sticky top-0 z-20">
                            <tr>
                                <th class="px-10 py-6 text-xs font-black text-slate-400 uppercase tracking-widest border-b cursor-pointer hover:bg-slate-100 transition-colors select-none group" @onclick='() => HandleSort("title")'>
                                    <div class="flex items-center gap-2">
                                        工作項目
                                        <span class="text-slate-300 group-hover:text-indigo-400 transition-colors">
                                            @if (_sortConfig.Key == "title")
                                            { <LucideIcon Name="@(_sortConfig.Dir == "asc" ? "chevron-up" : "chevron-down")" Class="w-4 h-4" /> }
                                            else { <LucideIcon Name="arrow-up-down" Class="w-4 h-4 opacity-50" /> }
                                        </span>
                                    </div>
                                </th>
                                <th class="px-8 py-6 text-xs font-black text-slate-400 uppercase tracking-widest border-b cursor-pointer hover:bg-slate-100 transition-colors select-none group" @onclick='() => HandleSort("group")'>
                                    <div class="flex items-center gap-2">
                                        執行小組與人員
                                        <span class="text-slate-300 group-hover:text-indigo-400 transition-colors">
                                            @if (_sortConfig.Key == "group")
                                            { <LucideIcon Name="@(_sortConfig.Dir == "asc" ? "chevron-up" : "chevron-down")" Class="w-4 h-4" /> }
                                            else { <LucideIcon Name="arrow-up-down" Class="w-4 h-4 opacity-50" /> }
                                        </span>
                                    </div>
                                </th>
                                <th class="px-8 py-6 text-xs font-black text-slate-400 uppercase tracking-widest border-b">進度</th>
                                <th class="px-10 py-6 border-b"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var task in VisibleTasks)
                            {
                                var (statusLabel, statusColor, statusIcon) = GetTaskStatus(task);
                                var g = AppState.Groups.FirstOrDefault(x => x.Name == task.Group);
                                var validTags = task.Tags.Where(tName => AppState.Tags.Any(t => t.Name == tName)).ToList();
                                var isDelayed = GetTaskStatusValue(task) == "delayed";
                                <tr class="hover:bg-indigo-50/30 transition-all cursor-pointer group/row" @onclick="() => _selectedTaskId = task.Id">
                                    <td class="px-10 py-6">
                                        <div class="flex items-center gap-3 font-bold text-slate-800 text-base">
                                            @task.Title
                                            <RecurrenceBadge Task="@task" />
                                            @if (task.Attachments.Count > 0)
                                            { <LucideIcon Name="paperclip" Class="w-4 h-4 text-slate-300" /> }
                                        </div>
                                        <div class="flex items-center gap-2 mt-1.5">
                                            <span class="text-xs text-slate-400 font-bold">@task.StartDate ~ @task.EndDate</span>
                                            @if (validTags.Count > 0)
                                            {
                                                <div class="flex gap-1.5 ml-3 border-l border-slate-200 pl-3">
                                                    @foreach (var tName in validTags)
                                                    {
                                                        var tObj = AppState.Tags.FirstOrDefault(t => t.Name == tName);
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-widest @(tObj?.Color?.Bg ?? "bg-slate-100") @(tObj?.Color?.Text ?? "text-slate-500")">@tName</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <div class="flex flex-col gap-1.5">
                                            <span class="w-fit text-xs font-black px-3 py-1 border rounded-full @(g?.Color?.Bg ?? "bg-slate-100") @(g?.Color?.Text ?? "text-slate-500")">@task.Group</span>
                                            <span class="text-xs text-slate-400 font-bold ml-1">@DisplayAssignee(task.Assignee)</span>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden shadow-inner">
                                                <div class="h-full transition-all duration-700 @(isDelayed ? "bg-rose-500" : "bg-indigo-600")" style="width: @(task.Progress)%"></div>
                                            </div>
                                            <span class="text-xs font-black text-slate-400">@(task.Progress)%</span>
                                        </div>
                                    </td>
                                    <td class="px-10 py-6 text-right flex gap-2 justify-end opacity-0 group-hover/row:opacity-100 transition-all">
                                        <button @onclick:stopPropagation="true" @onclick="() => OpenEditTask(task)"
                                                class="p-2.5 text-slate-300 hover:text-indigo-600 transition-all">
                                            <LucideIcon Name="pencil" Class="w-5 h-5" />
                                        </button>
                                        <button @onclick:stopPropagation="true" @onclick="() => _taskToDelete = task"
                                                class="p-2.5 text-slate-300 hover:text-rose-500 transition-all">
                                            <LucideIcon Name="trash-2" Class="w-5 h-5" />
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!VisibleTasks.Any())
                    {
                        <div class="py-40 text-center opacity-30 italic font-black text-2xl">目前無符合過濾條件的工作資料</div>
                    }
                </div>
            }

            @* Gantt view *@
            @if (_viewMode == "gantt")
            {
                var cfg = BuildGanttConfig();
                <div class="flex-1 overflow-auto relative scrollbar-thin">
                    <div class="inline-block min-w-full">
                        @* Gantt header *@
                        <div class="flex sticky top-0 z-40 bg-white/95 border-b border-slate-200 backdrop-blur shadow-sm items-stretch">
                            <div class="w-80 shrink-0 bg-slate-50/50 px-8 py-6 font-black text-sm text-slate-400 border-r border-slate-200 uppercase tracking-widest flex items-center justify-center">任務項目</div>
                            <div class="flex flex-col shrink-0">
                                <div class="flex border-b border-slate-200">
                                    @foreach (var th in cfg.TopHeaders)
                                    {
                                        <div class="text-center py-1.5 text-xs font-black text-slate-500 uppercase tracking-widest border-r border-slate-200 bg-slate-50/80 flex items-center justify-center"
                                             style="width: @(th.Span * cfg.ColWidth)px">@th.Label</div>
                                    }
                                </div>
                                <div class="flex flex-1">
                                    @foreach (var unit in cfg.Units)
                                    {
                                        bool isCur = CheckIsCurrent(unit.Date, _ganttScale);
                                        <div class="shrink-0 text-center py-2.5 border-r border-slate-100/50 flex flex-col items-center justify-center @(isCur ? "bg-yellow-50/70 border-b-2 border-b-yellow-400" : "")"
                                             style="width: @(cfg.ColWidth)px">
                                            <span class="text-[10px] font-black uppercase text-slate-400 leading-none">@unit.SubLabel</span>
                                            <span class="text-sm font-black mt-1 text-slate-600 leading-none">@unit.Label</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        @* Gantt rows *@
                        @foreach (var task in GanttVisibleTasks(cfg))
                        {
                            var (sLabel, sColor, sIcon) = GetTaskStatus(task);
                            bool isExpanded = _expandedTasks.Contains(task.Id);
                            double left  = GetGanttPos(task.StartDate, cfg);
                            double width = GetGanttWidth(task.StartDate, task.EndDate, cfg);
                            bool isDelayed = GetTaskStatusValue(task) == "delayed";
                            var validTags = task.Tags.Where(tName => AppState.Tags.Any(t => t.Name == tName)).ToList();
                            <div class="flex border-b border-slate-50 transition-all">
                                <div class="w-80 shrink-0 border-r border-slate-200 bg-white px-8 py-5 sticky left-0 z-20 flex items-center gap-4 shadow-md shadow-slate-100/50">
                                    <button @onclick="() => { if (_expandedTasks.Contains(task.Id)) _expandedTasks.Remove(task.Id); else _expandedTasks.Add(task.Id); }"
                                            class="text-slate-300 hover:text-indigo-600 transition-all">
                                        <LucideIcon Name="@(isExpanded ? "chevron-down" : "chevron-right")" Class="w-5 h-5" />
                                    </button>
                                    <div class="overflow-hidden cursor-pointer" @onclick="() => _selectedTaskId = task.Id">
                                        <div class="text-base font-black truncate text-slate-700 flex items-center gap-2">
                                            @task.Title
                                            @if (task.Attachments.Count > 0) { <LucideIcon Name="paperclip" Class="w-3 h-3 text-slate-300" /> }
                                        </div>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <div class="text-xs text-slate-400 font-bold uppercase truncate max-w-[120px]">@DisplayAssignee(task.Assignee)</div>
                                            <div class="text-xs text-slate-400 font-bold">· @(task.Progress)%</div>
                                            @foreach (var tName in validTags)
                                            {
                                                var tObj = AppState.Tags.FirstOrDefault(t => t.Name == tName);
                                                <div class="w-2 h-2 rounded-full @(tObj?.Color?.Active ?? "bg-slate-300")" title="@tName"></div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="relative @(isExpanded ? "pt-8 pb-10 bg-slate-50/30" : "pt-8 pb-8") shrink-0" style="width: @(cfg.Units.Count * cfg.ColWidth)px">
                                    <div class="absolute inset-0 z-0 flex pointer-events-none">
                                        @foreach (var unit in cfg.Units)
                                        {
                                            <div class="h-full border-r border-slate-100/30 @(CheckIsCurrent(unit.Date, _ganttScale) ? "bg-yellow-50/40" : "")" style="width: @(cfg.ColWidth)px"></div>
                                        }
                                    </div>
                                    <div class="relative z-10">
                                        <div class="relative h-10 rounded-xl border shadow-sm flex items-center px-5 cursor-pointer bg-white transition-all @(isDelayed ? "border-rose-200" : "border-indigo-100")"
                                             style="margin-left: @(left)px; width: @(Math.Max(width, 24))px"
                                             @onclick="() => _selectedTaskId = task.Id">
                                            <div class="absolute left-0 top-0 h-full rounded-xl opacity-20 @(isDelayed ? "bg-rose-500" : "bg-indigo-500")" style="width: @(task.Progress)%"></div>
                                            <span class="text-xs font-black z-20 @(isDelayed ? "text-rose-700" : "text-indigo-700")">@(task.Progress)%</span>
                                        </div>
                                        @if (isExpanded)
                                        {
                                            @foreach (var item in task.Checklist)
                                            {
                                                double iLeft  = GetGanttPos(item.StartDate ?? item.DueDate, cfg);
                                                double iWidth = GetGanttWidth(item.StartDate ?? item.DueDate, item.DueDate, cfg);
                                                <div class="relative flex items-center h-7 mt-3" style="margin-left: @(iLeft)px">
                                                    <div class="h-2.5 rounded-full border shadow-sm @(item.Completed ? "bg-emerald-500 border-emerald-200" : "bg-indigo-500 border-indigo-200")" style="width: @(Math.Max(iWidth, 12))px"></div>
                                                    <span class="ml-4 text-xs font-bold text-slate-500 whitespace-nowrap opacity-80">@item.Text</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Weekly / Monthly report *@
            @if (_viewMode is "weekly" or "monthly")
            {
                <div class="flex-1 overflow-y-auto p-10 space-y-10 bg-slate-50/50 scrollbar-thin">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6">
                        <h2 class="text-3xl font-black text-slate-800 flex items-center gap-4 uppercase tracking-tight">
                            <LucideIcon Name="@(_viewMode == "weekly" ? "newspaper" : "book-open")" Class="w-10 h-10 @(_viewMode == "weekly" ? "text-indigo-600" : "text-purple-600")" />
                            @(_viewMode == "weekly" ? "週報摘要" : $"{LastMonthLabel} 月報摘要")
                        </h2>
                        <div class="flex flex-wrap items-center gap-4">
                            <button @onclick="() => _hideTaggedInReport = !_hideTaggedInReport"
                                    class="flex items-center gap-2 px-5 py-2.5 rounded-full border shadow-sm text-sm font-black transition-all @(_hideTaggedInReport ? "bg-indigo-50 border-indigo-200 text-indigo-600 ring-2 ring-indigo-100 ring-offset-1" : "bg-white border-slate-200 text-slate-500 hover:bg-slate-50")">
                                <LucideIcon Name="filter" Class="w-4 h-4" />
                                @(_hideTaggedInReport ? "已隱藏標籤項目" : "隱藏標籤項目")
                            </button>
                            @if (_viewMode == "weekly")
                            {
                                <div class="flex items-center gap-3 bg-white px-5 py-2.5 rounded-full border shadow-sm flex-wrap">
                                    <LucideIcon Name="calendar-days" Class="w-5 h-5 text-slate-400" />
                                    <input type="date" class="bg-transparent text-sm font-black text-slate-600 outline-none cursor-pointer"
                                           @bind="ReportStartDate" />
                                    <span class="text-slate-300">~</span>
                                    <input type="date" class="bg-transparent text-sm font-black text-slate-600 outline-none cursor-pointer"
                                           @bind="ReportEndDate" />
                                    <button @onclick="() => { _reportRangeStart = FormatDate(DateTime.Today.AddDays(-7)); _reportRangeEnd = FormatDate(DateTime.Today); }"
                                            class="ml-2 p-1.5 hover:bg-slate-100 rounded-lg text-slate-400 transition-colors">
                                        <LucideIcon Name="refresh-cw" Class="w-4 h-4" />
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-sm font-black text-slate-400 bg-white px-6 py-3 rounded-full border shadow-sm uppercase tracking-widest">範圍：上個完整月份</span>
                            }
                        </div>
                    </div>

                    @{var reportRows = ReportData.ToList();}
                    @if (reportRows.Count > 0)
                    {
                        <div class="overflow-x-auto scrollbar-thin px-2 pb-6">
                            <table class="w-full text-left border-separate min-w-[1000px]" style="border-spacing: 0 1rem">
                                <thead>
                                    <tr>
                                        <th class="px-8 py-2 text-sm font-black text-slate-400 uppercase tracking-widest w-[30%]">工作項目</th>
                                        <th class="px-8 py-2 text-sm font-black text-slate-400 uppercase tracking-widest w-[35%]">日誌回報</th>
                                        <th class="px-8 py-2 text-sm font-black text-slate-400 uppercase tracking-widest w-[35%]">已完成細項</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in reportRows)
                                    {
                                        var (sLabel, sColor, sIcon) = GetTaskStatus(row.Task);
                                        var sv = GetTaskStatusValue(row.Task);
                                        string bgClass  = sv == "done" ? "bg-emerald-50/40" : sv == "doing" ? "bg-blue-50/40" : sv == "delayed" ? "bg-rose-50/40" : "bg-white";
                                        string indClass = sv == "done" ? "border-l-emerald-400" : sv == "doing" ? "border-l-blue-400" : sv == "delayed" ? "border-l-rose-400" : "border-l-slate-300";
                                        var validTags = row.Task.Tags.Where(tName => AppState.Tags.Any(t => t.Name == tName)).ToList();
                                        <tr class="group align-top hover:-translate-y-1 transition-all duration-300 drop-shadow-sm hover:drop-shadow-md">
                                            <td class="px-8 py-6 rounded-l-2xl border-y border-l border-slate-200 border-l-[6px] @indClass @bgClass">
                                                <div class="flex items-start justify-between gap-4 mb-3">
                                                    <h3 class="font-black text-slate-900 text-lg leading-tight">
                                                        @row.Task.Title
                                                        <div class="mt-2"><RecurrenceBadge Task="@row.Task" /></div>
                                                    </h3>
                                                    <button @onclick="() => _selectedTaskId = row.Task.Id"
                                                            class="shrink-0 p-2 bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 rounded-xl transition-all shadow-sm flex items-center gap-1.5 text-xs font-bold">
                                                        <LucideIcon Name="external-link" Class="w-3.5 h-3.5" /> 詳情
                                                    </button>
                                                </div>
                                                <div class="space-y-1.5">
                                                    <div class="text-xs font-bold text-slate-500 uppercase tracking-tighter flex items-center gap-1.5"><LucideIcon Name="user" Class="w-3.5 h-3.5" /> @DisplayAssignee(row.Task.Assignee)</div>
                                                    <div class="text-xs font-bold text-slate-500 uppercase tracking-tighter flex items-center gap-1.5"><LucideIcon Name="layers" Class="w-3.5 h-3.5" /> @row.Task.Group</div>
                                                    <div class="text-xs font-bold text-slate-500 uppercase tracking-tighter flex items-center gap-1.5"><LucideIcon Name="activity" Class="w-3.5 h-3.5" /> 進度 @(row.Task.Progress)%</div>
                                                </div>
                                                @if (validTags.Count > 0)
                                                {
                                                    <div class="flex flex-wrap gap-1 mt-4 pt-4 border-t border-slate-200/50">
                                                        @foreach (var tName in validTags)
                                                        {
                                                            var tObj = AppState.Tags.FirstOrDefault(t => t.Name == tName);
                                                            <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-widest @(tObj?.Color?.Bg ?? "bg-white") @(tObj?.Color?.Text ?? "text-slate-500") border @(tObj?.Color?.Border ?? "border-slate-200")">@tName</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td class="px-8 py-6 border-y border-l border-slate-200 @bgClass">
                                                @if (row.Logs.Count > 0)
                                                {
                                                    <div class="space-y-3">
                                                        @foreach (var l in row.Logs)
                                                        {
                                                            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm relative before:absolute before:left-0 before:top-0 before:bottom-0 before:w-1 before:bg-indigo-400 before:rounded-l-xl overflow-hidden">
                                                                <p class="text-sm text-slate-700 whitespace-pre-wrap leading-relaxed font-medium">@l.Text</p>
                                                                <div class="mt-2 flex items-center gap-1 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                                                    <LucideIcon Name="clock" Class="w-3 h-3" />
                                                                    @(l.Timestamp is not null ? DateTime.Parse(l.Timestamp).ToString("yyyy-MM-dd HH:mm") : "傳送中")
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else { <div class="h-full flex items-center justify-center text-sm text-slate-300 italic font-bold opacity-50 py-4">無日誌更新</div> }
                                            </td>
                                            <td class="px-8 py-6 rounded-r-2xl border-y border-l border-r border-slate-200 @bgClass">
                                                @if (row.Checklist.Count > 0)
                                                {
                                                    <div class="space-y-3">
                                                        @foreach (var i in row.Checklist)
                                                        {
                                                            <div class="flex items-start gap-3 bg-white p-4 rounded-xl border border-slate-200 shadow-sm relative before:absolute before:left-0 before:top-0 before:bottom-0 before:w-1 before:bg-emerald-400 before:rounded-l-xl overflow-hidden">
                                                                <LucideIcon Name="check-circle-2" Class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
                                                                <div>
                                                                    <p class="text-sm font-bold text-slate-700 leading-tight">@i.Text</p>
                                                                    <span class="text-[10px] font-black text-emerald-600 block mt-1.5 uppercase tracking-widest">完成時間：@i.ActualDoneDate</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else { <div class="h-full flex items-center justify-center text-sm text-slate-300 italic font-bold opacity-50 py-4">無完成細項</div> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-40 text-center opacity-30 italic font-black text-2xl">此時段無符合過濾條件的更新紀錄</div>
                    }
                </div>
            }
        </div>
    </main>
</div>

@* ── Task Detail Modal ──────────────────────────────────────────────────────── *@
@if (_selectedTaskId is not null && SelectedTask is { } currentTask)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md"
         @onclick="() => { _selectedTaskId = null; _editingChecklistId = null; _newChecklistItem = string.Empty; _detailLinkName = string.Empty; _detailLinkUrl = string.Empty; }">
        <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-6xl flex flex-col md:flex-row max-h-[90vh] overflow-hidden shadow-slate-900/30"
             @onclick:stopPropagation="true">

            @* Left panel — checklist + attachments *@
            <div class="flex-1 flex flex-col border-r border-slate-100 p-12 overflow-y-auto scrollbar-thin">
                <div class="mb-8">
                    @{
                        var (dLabel, dColor, dIcon) = GetTaskStatus(currentTask);
                        var validTagsD = currentTask.Tags.Where(tName => AppState.Tags.Any(t => t.Name == tName)).ToList();
                    }
                    <div class="flex items-center gap-3 mb-4">
                        <span class="px-5 py-2 rounded-full text-xs font-black border @dColor">@dLabel</span>
                        <RecurrenceBadge Task="@currentTask" />
                        @if (validTagsD.Count > 0)
                        {
                            <div class="flex items-center gap-2 ml-2 pl-3 border-l border-slate-200">
                                @foreach (var tName in validTagsD)
                                {
                                    var tObj  = AppState.Tags.FirstOrDefault(t => t.Name == tName);
                                    var cObj  = tObj?.Color;
                                    <span class="flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-black uppercase tracking-widest border @(cObj?.Bg ?? "bg-slate-100") @(cObj?.Text ?? "text-slate-400") @(cObj?.Border ?? "border-slate-200")">
                                        @tName
                                        <button @onclick="() => HandleRemoveTagFromTask(currentTask, tName)"
                                                class="hover:text-rose-500 transition-colors opacity-50 hover:opacity-100 p-0.5 ml-0.5 bg-white/50 hover:bg-white rounded-full">
                                            <LucideIcon Name="x" Class="w-3 h-3" />
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <h3 class="text-4xl font-black text-slate-900 leading-tight uppercase tracking-tight">@currentTask.Title</h3>
                    <div class="flex flex-col gap-3 mt-4 bg-slate-50 px-5 py-4 rounded-xl border border-slate-100 w-full md:w-fit">
                        <div class="flex flex-wrap items-center gap-2">
                            <div class="flex items-center gap-2 text-sm font-black text-slate-400 uppercase tracking-widest shrink-0">
                                <LucideIcon Name="calendar-days" Class="w-5 h-5" /> 計畫時程：
                            </div>
                            <div class="text-base font-black text-slate-700 whitespace-nowrap">@currentTask.StartDate <span class="mx-2 text-slate-300">→</span> @currentTask.EndDate</div>
                        </div>
                        <div class="flex flex-wrap items-start gap-2">
                            <div class="flex items-center gap-2 text-sm font-black text-slate-400 uppercase tracking-widest shrink-0 mt-0.5">
                                <LucideIcon Name="user" Class="w-5 h-5" /> 負責人員：
                            </div>
                            <div class="text-base font-black text-slate-700 leading-relaxed">@DisplayAssignee(currentTask.Assignee)</div>
                        </div>
                    </div>
                </div>

                @* Attachments *@
                <div class="mb-10">
                    <div class="mb-6 flex items-center justify-between">
                        <h4 class="text-lg font-black text-slate-900 flex items-center gap-3 tracking-tight">
                            <LucideIcon Name="paperclip" Class="w-6 h-6 text-indigo-500" /> 附件與相關網址
                        </h4>
                    </div>
                    @if (currentTask.Attachments.Count > 0)
                    {
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                            @foreach (var att in currentTask.Attachments)
                            {
                                <div class="relative group">
                                    @if (att.Type == "image")
                                    {
                                        <button @onclick="() => _previewImage = att.Url"
                                                class="block w-full h-full relative rounded-xl overflow-hidden border border-slate-200 aspect-video bg-slate-100 shadow-sm hover:shadow-md transition-all text-left">
                                            <img src="@att.Url" alt="@att.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                            <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-sm">
                                                <LucideIcon Name="search" Class="w-6 h-6 text-white" />
                                            </div>
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="@att.Url" target="_blank" rel="noopener noreferrer"
                                           class="flex items-center gap-3 p-3 bg-white border border-slate-200 rounded-xl hover:border-indigo-300 hover:shadow-md transition-all h-full">
                                            <div class="p-2 bg-indigo-50 rounded-lg group-hover:bg-indigo-100 transition-colors">
                                                <LucideIcon Name="link" Class="w-5 h-5 text-indigo-500" />
                                            </div>
                                            <div class="overflow-hidden flex-1">
                                                <p class="text-sm font-bold text-slate-700 truncate">@att.Name</p>
                                                <p class="text-[10px] text-slate-400 truncate mt-0.5">@att.Url</p>
                                            </div>
                                        </a>
                                    }
                                    <button @onclick="() => HandleDetailDeleteAttachment(currentTask, att.Id)"
                                            class="absolute -top-2 -right-2 bg-white border border-slate-200 text-slate-400 hover:text-rose-500 hover:border-rose-200 p-1.5 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-all z-10">
                                        <LucideIcon Name="trash-2" Class="w-3.5 h-3.5" />
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    <div class="p-6 bg-slate-50 rounded-3xl border border-slate-200 shadow-inner space-y-4">
                        <div class="flex gap-2 items-center">
                            <input type="text" placeholder="顯示名稱 (選填)" class="w-1/3 p-3 bg-white border border-slate-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-100"
                                   @bind="_detailLinkName" />
                            <input type="text" placeholder="網址 https://..." class="flex-1 p-3 bg-white border border-slate-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-100"
                                   @bind="_detailLinkUrl"
                                   @onkeydown='async e => { if (e.Key == "Enter") await HandleDetailAddLink(currentTask); }' />
                            <button @onclick="() => HandleDetailAddLink(currentTask)"
                                    class="px-5 py-3 bg-slate-900 text-white rounded-xl font-black shadow-md hover:bg-slate-800 transition-all text-sm whitespace-nowrap">新增連結</button>
                        </div>
                        <div class="flex items-center gap-4 pt-2">
                            <label class="flex items-center gap-2 px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-black text-slate-600 cursor-pointer hover:bg-slate-100 transition-colors shadow-sm">
                                <LucideIcon Name="upload" Class="w-4 h-4 text-indigo-500" /> 上傳電腦圖片
                                <InputFile OnChange="e => HandleImageUpload(e, currentTask)" accept="image/*" class="hidden" />
                            </label>
                            <span class="text-[10px] font-bold text-slate-400">支援影像格式。系統將自動最佳化並壓縮影像尺寸。</span>
                        </div>
                    </div>
                </div>

                @* Checklist *@
                <div class="mb-6 flex items-center justify-between">
                    <h4 class="text-lg font-black text-slate-900 flex items-center gap-3 tracking-tight">
                        <LucideIcon Name="check-square" Class="w-6 h-6 text-indigo-500" /> 工作分解項目
                    </h4>
                </div>

                @if (_showRecurConfirm)
                {
                    <div class="mb-6 p-5 bg-indigo-50 rounded-2xl border-2 border-indigo-500 animate-pulse flex items-center justify-between shadow-lg">
                        <p class="text-xs font-black text-indigo-700">任務已 100% 完成！是否要以此為基準複刻下期任務？</p>
                        <div class="flex gap-2">
                            <button disabled="@_isRecurProcessing" @onclick="() => ExecuteRecurrence(currentTask)"
                                    class="bg-indigo-600 text-white px-5 py-2 rounded-xl text-[10px] font-black hover:bg-indigo-700 shadow-md">確認複刻</button>
                            <button @onclick="() => _showRecurConfirm = false"
                                    class="bg-white border border-indigo-200 text-indigo-400 px-5 py-2 rounded-xl text-[10px] font-black">先不複刻</button>
                        </div>
                    </div>
                }

                <div class="space-y-4 mb-10">
                    @foreach (var item in currentTask.Checklist)
                    {
                        <div class="flex items-center gap-5 p-5 bg-slate-50 rounded-2xl group border border-transparent hover:border-indigo-100 hover:bg-white shadow-sm transition-all">
                            <button @onclick="() => ToggleChecklistItem(currentTask, item)" class="shrink-0 active:scale-75 transition-transform">
                                @if (item.Completed)
                                { <LucideIcon Name="check-circle-2" Class="w-8 h-8 text-emerald-500" /> }
                                else
                                { <LucideIcon Name="square" Class="w-8 h-8 text-slate-300" /> }
                            </button>
                            <div class="flex flex-col flex-1">
                                <span class="text-base font-bold @(item.Completed ? "text-slate-400 line-through" : "text-slate-700")">@item.Text</span>
                                <div class="flex items-center gap-4 mt-1.5">
                                    <span class="text-xs font-black text-slate-400 uppercase tracking-tighter">期限：@item.StartDate ~ @item.DueDate</span>
                                    @if (item.Completed && item.ActualDoneDate is not null)
                                    {
                                        <span class="flex items-center gap-2 text-xs font-black text-emerald-500 bg-emerald-50 px-2 py-1 rounded border border-emerald-100">
                                            <LucideIcon Name="clock" Class="w-3 h-3" /> 完成於 @item.ActualDoneDate
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="flex items-center gap-1 text-slate-300">
                                <button @onclick="() => { _editingChecklistId = item.Id.ToString(); _newChecklistItem = item.Text; _newChecklistStartDate = item.StartDate ?? currentTask.StartDate ?? FormatDate(DateTime.Today); _newChecklistEndDate = item.DueDate ?? currentTask.EndDate ?? FormatDate(DateTime.Today); }"
                                        class="hover:text-indigo-600 p-2.5 transition-all">
                                    <LucideIcon Name="pencil" Class="w-5 h-5" />
                                </button>
                                <button @onclick="() => DeleteChecklistItem(currentTask, item.Id)"
                                        class="hover:text-rose-500 p-2.5 transition-all">
                                    <LucideIcon Name="x" Class="w-5 h-5" />
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-8 rounded-3xl border shadow-inner transition-colors @(_editingChecklistId is not null ? "bg-indigo-50/50 border-indigo-200" : "bg-slate-50 border-slate-200")">
                    @if (_editingChecklistId is not null)
                    {
                        <div class="flex items-center justify-between mb-4 bg-white px-4 py-2 rounded-xl border border-indigo-100 shadow-sm">
                            <span class="text-xs font-black text-indigo-600 uppercase flex items-center gap-2">
                                <LucideIcon Name="pencil" Class="w-4 h-4" /> 正在編輯分解項目...
                            </span>
                            <button @onclick="() => { _editingChecklistId = null; _newChecklistItem = string.Empty; }" class="text-slate-400 hover:text-rose-500 transition-colors p-1">
                                <LucideIcon Name="x" Class="w-4 h-4" />
                            </button>
                        </div>
                    }
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div class="flex flex-col">
                            <label class="text-xs font-black text-slate-400 mb-2 uppercase tracking-widest">子項開始</label>
                            <input type="date" class="bg-white px-4 py-3 rounded-xl text-sm font-bold border border-slate-200 focus:ring-4 focus:ring-indigo-100"
                                   @bind="ChecklistStart" />
                        </div>
                        <div class="flex flex-col">
                            <label class="text-[10px] font-black text-slate-400 mb-2 uppercase tracking-widest">子項截止</label>
                            <input type="date" class="bg-white px-4 py-3 rounded-xl text-sm font-bold border border-slate-200 focus:ring-4 focus:ring-indigo-100"
                                   @bind="ChecklistEnd" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_checklistError))
                    { <p class="text-xs text-rose-500 mb-2 font-bold">@_checklistError</p> }
                    <div class="flex gap-3 relative">
                        <input type="text" placeholder="描述細項內容..."
                               class="flex-1 bg-white px-5 py-4 rounded-xl text-base font-bold outline-none border border-slate-200 focus:ring-4 focus:ring-indigo-100 transition-all"
                               @bind="_newChecklistItem"
                               @onkeydown='async e => { if (e.Key == "Enter") await HandleAddChecklistItem(); }' />
                        <button @onclick="HandleAddChecklistItem"
                                class="@(_editingChecklistId is not null ? "bg-indigo-600 hover:bg-indigo-700" : "bg-slate-900 hover:bg-slate-800") text-white px-6 rounded-xl active:scale-95 transition-all shadow-md flex items-center justify-center font-black">
                            @if (_editingChecklistId is not null) { @("儲存") } else { <LucideIcon Name="plus" Class="w-6 h-6" /> }
                        </button>
                    </div>
                </div>
            </div>

            @* Right panel — logs *@
            <div class="w-full md:w-[420px] bg-slate-50/50 flex flex-col p-10 overflow-hidden border-l border-slate-100 shadow-inner">
                <h4 class="text-lg font-black mb-8 flex items-center gap-3 tracking-tight">
                    <LucideIcon Name="message-square" Class="w-6 h-6 text-indigo-400" /> 進度日誌
                </h4>
                <div class="flex-1 overflow-y-auto space-y-5 mb-8 scrollbar-thin">
                    @foreach (var log in AppState.Logs.Where(l => l.TaskId == currentTask.Id)
                                         .OrderByDescending(l => TryParseTimestamp(l.Timestamp) ?? DateTime.MinValue))
                    {
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 group/log relative shadow-slate-200/40">
                            <p class="text-sm text-slate-600 leading-relaxed font-medium whitespace-pre-wrap">@log.Text</p>
                            <div class="flex items-center justify-between mt-3">
                                <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">
                                    @(log.Timestamp is not null ? DateTime.Parse(log.Timestamp).ToShortDateString() : "傳送中")
                                    @(log.UpdatedAt is not null ? " (已編輯)" : "")
                                </span>
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => { _editingLogId = log.Id; _newLogText = log.Text; }"
                                            class="opacity-0 group-hover/log:opacity-100 p-1.5 text-slate-300 hover:text-indigo-600 transition-all">
                                        <LucideIcon Name="pencil" Class="w-4 h-4" />
                                    </button>
                                    <button @onclick="() => HandleDeleteLog(log.Id)"
                                            class="opacity-0 group-hover/log:opacity-100 p-1.5 text-slate-300 hover:text-rose-500 transition-all">
                                        <LucideIcon Name="trash-2" Class="w-4 h-4" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="flex flex-col gap-3 p-3 bg-white rounded-2xl border @(_editingLogId is not null ? "border-indigo-400 ring-4 ring-indigo-50 shadow-lg" : "border-slate-200 shadow-sm")">
                    @if (_editingLogId is not null)
                    {
                        <div class="flex items-center justify-between px-3 py-1.5 bg-indigo-50 rounded-lg">
                            <span class="text-xs font-black text-indigo-600 uppercase">正在編輯日誌...</span>
                            <button @onclick="() => { _editingLogId = null; _newLogText = string.Empty; }" class="text-indigo-400 hover:text-rose-500">
                                <LucideIcon Name="x" Class="w-3 h-3" />
                            </button>
                        </div>
                    }
                    <div class="flex gap-3">
                        <textarea rows="2" placeholder="撰寫回報..."
                                  class="flex-1 px-4 py-3 bg-transparent text-sm font-bold outline-none resize-none"
                                  @bind="_newLogText" @bind:event="oninput"
                                  @onkeydown='async e => { if (e.Key == "Enter" && !e.ShiftKey) { await HandleSendLog(); } }'></textarea>
                        <button @onclick="HandleSendLog"
                                class="px-5 rounded-xl active:scale-90 transition-all shadow-lg self-end mb-1 mr-1 py-4 @(_editingLogId is not null ? "bg-indigo-600 text-white" : "bg-slate-900 text-white")">
                            @if (_editingLogId is not null) { <LucideIcon Name="check-circle" Class="w-6 h-6" /> }
                            else { <LucideIcon Name="send" Class="w-6 h-6" /> }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ── Task Create / Edit Modal ───────────────────────────────────────────────── *@
@if (_isTaskModalOpen)
{
    <div class="fixed inset-0 z-[150] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm"
         @onclick="() => _isTaskModalOpen = false">
        <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-2xl overflow-hidden" @onclick:stopPropagation="true">
            <div class="px-12 py-10 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="text-2xl font-black">@(_editingTaskId is not null ? "編輯工作" : "建立新工作")</h3>
                <button @onclick="() => _isTaskModalOpen = false" class="p-3 hover:bg-slate-100 rounded-xl transition-all">
                    <LucideIcon Name="x" Class="w-8 h-8 text-slate-400" />
                </button>
            </div>
            <form @onsubmit:preventDefault @onsubmit="HandleSaveTask" class="p-12 space-y-8 scrollbar-thin overflow-y-auto max-h-[80vh]">
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="p-5 bg-rose-50 border border-rose-100 rounded-2xl flex items-center gap-3 text-rose-600 text-sm font-black">
                        <LucideIcon Name="alert-circle" Class="w-5 h-5" /> @_formError
                    </div>
                }

                <div>
                    <label class="text-xs font-black text-slate-400 uppercase mb-3 block tracking-widest">工作標題</label>
                    <input class="w-full p-5 bg-slate-50 border border-slate-200 rounded-2xl outline-none font-bold text-base shadow-sm focus:ring-4 focus:ring-indigo-100/50 transition-all"
                           @bind="_taskForm.Title" />
                </div>

                <div>
                    <label class="text-xs font-black text-slate-400 uppercase mb-4 block tracking-widest flex items-center gap-2">
                        <LucideIcon Name="tag" Class="w-4 h-4" /> 專案標籤 (可複選)
                    </label>
                    @if (AppState.Tags.Count > 0)
                    {
                        <div class="flex flex-wrap gap-3">
                            @foreach (var t in AppState.Tags)
                            {
                                bool isSel = _taskForm.Tags.Contains(t.Name);
                                <button type="button"
                                        @onclick="() => { if (isSel) _taskForm.Tags.Remove(t.Name); else _taskForm.Tags.Add(t.Name); }"
                                        class="px-5 py-2.5 rounded-xl text-sm font-black border transition-all flex items-center gap-2 @(isSel ? $"{t.Color?.Active ?? "bg-indigo-600"} text-white shadow-lg" : $"{t.Color?.Bg ?? "bg-slate-50"} {t.Color?.Text ?? "text-slate-500"} border-transparent shadow-sm hover:bg-slate-200")">
                                    @t.Name
                                    @if (isSel) { <LucideIcon Name="x" Class="w-4 h-4" /> }
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-sm font-bold text-slate-400 bg-slate-50 p-4 rounded-xl border border-slate-100">目前尚無專案標籤，可於主畫面右上角點擊「標籤圖示」進行管理。</div>
                    }
                </div>

                <div>
                    <label class="text-xs font-black text-slate-400 uppercase mb-4 block tracking-widest">執行小組選擇 (單選)</label>
                    @if (AppState.Groups.Count > 0)
                    {
                        <div class="flex flex-wrap gap-3">
                            @foreach (var g in AppState.Groups)
                            {
                                <button type="button" @onclick="() => _taskForm.Group = g.Name"
                                        class="px-6 py-3 rounded-xl text-sm font-black border transition-all @(_taskForm.Group == g.Name ? $"{g.Color?.Active ?? "bg-indigo-600"} text-white shadow-lg" : $"{g.Color?.Bg ?? "bg-slate-50"} {g.Color?.Text ?? "text-slate-500"} border-transparent shadow-sm")">
                                    @g.Name
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-sm font-bold text-rose-500 bg-rose-50 p-4 rounded-xl border border-rose-100 flex items-center gap-2">
                            <LucideIcon Name="alert-circle" Class="w-5 h-5" /> 請先關閉此視窗，並點擊右上角設定建立執行小組。
                        </div>
                    }
                </div>

                <div>
                    <label class="text-xs font-black text-slate-400 uppercase mb-3 block tracking-widest">負責人員 (可多選)</label>
                    @if (_taskForm.Assignee.Count > 0)
                    {
                        <div class="flex flex-wrap gap-2 mb-3">
                            @foreach (var a in _taskForm.Assignee.ToList())
                            {
                                <span class="flex items-center gap-1.5 bg-teal-50 text-teal-700 px-3 py-1.5 rounded-lg text-sm font-bold border border-teal-200">
                                    @a
                                    <button type="button" @onclick="() => _taskForm.Assignee.Remove(a)" class="hover:text-rose-500 transition-colors">
                                        <LucideIcon Name="x" Class="w-3.5 h-3.5" />
                                    </button>
                                </span>
                            }
                        </div>
                    }
                    <div class="flex gap-2">
                        <input class="flex-1 p-4 bg-slate-50 border border-slate-200 rounded-2xl outline-none font-bold text-base shadow-sm focus:ring-4 focus:ring-indigo-100/50 transition-all"
                               placeholder="輸入人員名稱後，按 Enter 新增..."
                               @bind="_assigneeInput"
                               @onkeydown='e => { if (e.Key == "Enter") AddAssignee(); }' />
                        <button type="button" @onclick="AddAssignee"
                                class="px-6 bg-slate-900 text-white rounded-2xl font-black shadow-md hover:bg-slate-800 transition-all active:scale-95">新增</button>
                    </div>
                    @if (RememberedAssignees.Any())
                    {
                        <div class="mt-4 flex flex-wrap gap-3 items-center">
                            <span class="text-xs font-black text-slate-400 uppercase tracking-widest">常用記憶：</span>
                            @foreach (var name in RememberedAssignees)
                            {
                                bool isSel = _taskForm.Assignee.Contains(name);
                                <button type="button"
                                        @onclick="() => { if (isSel) _taskForm.Assignee.Remove(name); else _taskForm.Assignee.Add(name); }"
                                        class="px-3 py-1.5 bg-white border border-slate-200 text-slate-500 rounded-lg text-xs font-bold hover:border-teal-400 hover:text-teal-600 transition-all @(isSel ? "ring-2 ring-teal-500 text-teal-700 shadow-sm bg-teal-50" : "")">@name</button>
                            }
                        </div>
                    }
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="text-xs font-black text-slate-400 mb-3 block tracking-widest">開始日期</label>
                        <input type="date" class="w-full p-5 bg-slate-50 border rounded-2xl font-bold text-base shadow-sm"
                               @bind="FormStartDate" />
                    </div>
                    <div>
                        <label class="text-xs font-black text-slate-400 mb-3 block tracking-widest">截止日期</label>
                        <input type="date" class="w-full p-5 bg-slate-50 border rounded-2xl font-bold text-base shadow-sm"
                               @bind="FormEndDate" />
                    </div>
                </div>

                <div class="bg-indigo-50/50 p-6 rounded-3xl border border-indigo-100 space-y-5 shadow-inner">
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-black text-indigo-600 uppercase flex items-center gap-3 tracking-widest">
                            <LucideIcon Name="repeat" Class="w-5 h-5" /> 這是例行性循環任務
                        </label>
                        <input type="checkbox" class="w-6 h-6 accent-indigo-600 cursor-pointer shadow-sm"
                               @bind="_taskForm.IsRecurring" />
                    </div>
                    @if (_taskForm.IsRecurring)
                    {
                        <div class="flex items-center gap-4 pt-4 border-t border-indigo-100/50">
                            <span class="text-sm font-black text-indigo-600">每</span>
                            <input type="number" min="1"
                                   class="w-20 p-3 bg-white border border-indigo-200 rounded-xl text-center font-bold text-base shadow-sm focus:ring-4 focus:ring-indigo-100 outline-none"
                                   @bind="_taskForm.RecurrenceInterval" />
                            <div class="flex bg-white rounded-xl shadow-sm border border-indigo-200 p-1">
                                @foreach (var (rv, rl) in new[] { ("daily","日"), ("weekly","週"), ("monthly","月") })
                                {
                                    <button type="button" @onclick="() => _taskForm.RecurrenceType = rv"
                                            class="px-4 py-2 rounded-lg text-sm font-black transition-all @(_taskForm.RecurrenceType == rv ? "bg-indigo-100 text-indigo-700" : "text-slate-400 hover:bg-slate-50")">@rl</button>
                                }
                            </div>
                            <span class="text-sm font-black text-indigo-600">自動建立新任務</span>
                        </div>
                    }
                </div>

                <button disabled="@_isSubmittingTask" type="submit"
                        class="w-full font-black py-6 rounded-[1.5rem] shadow-xl active:scale-95 transition-all text-lg bg-indigo-600 text-white hover:bg-indigo-700 shadow-indigo-100 disabled:bg-slate-300 disabled:shadow-none">
                    @if (_isSubmittingTask) { <LucideIcon Name="loader-2" Class="w-6 h-6 animate-spin mx-auto" /> }
                    else { @(_editingTaskId is not null ? "確認修改" : "確認任務") }
                </button>
            </form>
        </div>
    </div>
}

@* ── Tag Manager Modal ─────────────────────────────────────────────────────── *@
@if (_isManagingTags)
{
    <div class="fixed inset-0 z-[150] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm"
         @onclick="() => { _isManagingTags = false; ResetTagForm(); }">
        <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden" @onclick:stopPropagation="true">
            <div class="px-10 py-8 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="text-xl font-black flex items-center gap-3"><LucideIcon Name="tag" Class="w-6 h-6 text-indigo-500" />專案標籤管理</h3>
                <button @onclick="() => { _isManagingTags = false; ResetTagForm(); }"><LucideIcon Name="x" Class="w-6 h-6 text-slate-400" /></button>
            </div>
            <div class="p-10 space-y-6">
                <div class="space-y-3 max-h-[300px] overflow-y-auto scrollbar-thin pr-2">
                    @foreach (var t in AppState.Tags)
                    {
                        <div class="flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
                            <div class="flex items-center gap-4">
                                <div class="w-4 h-4 rounded-full @(t.Color?.Active ?? "bg-slate-400")"></div>
                                <span class="font-bold text-slate-700">@t.Name</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button @onclick="() => { _editingTagId = t.Id; _newTagName = t.Name; _newTagColor = t.Color ?? ColorConstants.TagColors[0]; }"
                                        class="text-slate-400 hover:text-indigo-600 transition-colors p-2 bg-slate-50 hover:bg-indigo-50 rounded-xl">
                                    <LucideIcon Name="pencil" Class="w-4 h-4" />
                                </button>
                                <button @onclick="() => HandleDeleteTag(t.Id, t.Name)"
                                        class="text-slate-400 hover:text-rose-500 transition-colors p-2 bg-slate-50 hover:bg-rose-50 rounded-xl">
                                    <LucideIcon Name="trash-2" Class="w-4 h-4" />
                                </button>
                            </div>
                        </div>
                    }
                    @if (!AppState.Tags.Any()) { <p class="text-sm font-bold text-slate-400 text-center py-4">目前尚無標籤</p> }
                </div>
                <form @onsubmit:preventDefault @onsubmit="HandleSaveTag" class="bg-slate-50 p-6 rounded-3xl space-y-4 border border-slate-200 shadow-inner">
                    @if (_editingTagId is not null)
                    {
                        <div class="flex items-center justify-between px-3 py-1.5 bg-indigo-50 rounded-lg">
                            <span class="text-xs font-black text-indigo-600 uppercase">正在編輯標籤...</span>
                            <button type="button" @onclick="ResetTagForm" class="text-indigo-400 hover:text-rose-500"><LucideIcon Name="x" Class="w-4 h-4" /></button>
                        </div>
                    }
                    <input type="text" placeholder="輸入新標籤名稱..."
                           class="w-full px-5 py-4 bg-white border border-slate-200 rounded-2xl outline-none font-bold shadow-sm focus:ring-4 focus:ring-indigo-100/50 transition-all"
                           @bind="_newTagName" />
                    <div class="grid grid-cols-9 gap-3">
                        @foreach (var c in ColorConstants.TagColors)
                        {
                            <button type="button" @onclick="() => _newTagColor = c"
                                    class="w-8 h-8 rounded-full border-2 transition-all @c.Active @(_newTagColor?.Label == c.Label ? "ring-4 ring-indigo-500/20 scale-110 border-white shadow-md" : "border-transparent opacity-60")">
                            </button>
                        }
                    </div>
                    <div class="flex gap-3">
                        @if (_editingTagId is not null)
                        {
                            <button type="button" @onclick="ResetTagForm" class="w-1/3 bg-slate-200 text-slate-600 font-black py-4 rounded-2xl shadow-sm active:scale-95">取消</button>
                        }
                        <button disabled="@(_isSavingTag || string.IsNullOrWhiteSpace(_newTagName))" type="submit"
                                class="flex-1 bg-slate-900 text-white font-black py-4 rounded-2xl shadow-lg active:scale-95 flex items-center justify-center gap-2 disabled:bg-slate-300 disabled:shadow-none">
                            @if (_isSavingTag) { <LucideIcon Name="loader-2" Class="w-4 h-4 animate-spin" /> }
                            else { @(_editingTagId is not null ? "儲存修改" : "新增標籤") }
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ── Group Manager Modal ───────────────────────────────────────────────────── *@
@if (_isManagingGroups)
{
    <div class="fixed inset-0 z-[150] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm"
         @onclick="() => { _isManagingGroups = false; ResetGroupForm(); }">
        <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden" @onclick:stopPropagation="true">
            <div class="px-10 py-8 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="text-xl font-black flex items-center gap-3"><LucideIcon Name="layers" Class="w-6 h-6 text-indigo-500" />執行小組管理</h3>
                <button @onclick="() => { _isManagingGroups = false; ResetGroupForm(); }"><LucideIcon Name="x" Class="w-6 h-6 text-slate-400" /></button>
            </div>
            <div class="p-10 space-y-6">
                <div class="space-y-3 max-h-[300px] overflow-y-auto scrollbar-thin pr-2">
                    @foreach (var g in AppState.Groups)
                    {
                        <div class="flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
                            <div class="flex items-center gap-4">
                                <div class="w-4 h-4 rounded-full @(g.Color?.Active ?? "bg-slate-400")"></div>
                                <span class="font-bold text-slate-700">@g.Name</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button @onclick="() => { _editingGroupId = g.Id; _newGroupName = g.Name; _newGroupColor = g.Color ?? ColorConstants.GroupColors[0]; }"
                                        class="text-slate-400 hover:text-indigo-600 transition-colors p-2 bg-slate-50 hover:bg-indigo-50 rounded-xl">
                                    <LucideIcon Name="pencil" Class="w-4 h-4" />
                                </button>
                                <button @onclick="() => HandleDeleteGroup(g.Id, g.Name)"
                                        class="text-slate-400 hover:text-rose-500 transition-colors p-2 bg-slate-50 hover:bg-rose-50 rounded-xl">
                                    <LucideIcon Name="trash-2" Class="w-4 h-4" />
                                </button>
                            </div>
                        </div>
                    }
                    @if (!AppState.Groups.Any()) { <p class="text-sm font-bold text-slate-400 text-center py-4">目前尚無小組</p> }
                </div>
                <form @onsubmit:preventDefault @onsubmit="HandleSaveGroup" class="bg-slate-50 p-6 rounded-3xl space-y-4 border border-slate-200 shadow-inner">
                    @if (_editingGroupId is not null)
                    {
                        <div class="flex items-center justify-between px-3 py-1.5 bg-indigo-50 rounded-lg">
                            <span class="text-xs font-black text-indigo-600 uppercase">正在編輯小組...</span>
                            <button type="button" @onclick="ResetGroupForm" class="text-indigo-400 hover:text-rose-500"><LucideIcon Name="x" Class="w-4 h-4" /></button>
                        </div>
                    }
                    <input type="text" placeholder="輸入新小組名稱..."
                           class="w-full px-5 py-4 bg-white border border-slate-200 rounded-2xl outline-none font-bold shadow-sm focus:ring-4 focus:ring-indigo-100/50 transition-all"
                           @bind="_newGroupName" />
                    <div class="flex flex-wrap gap-2">
                        @foreach (var c in ColorConstants.GroupColors)
                        {
                            <button type="button" @onclick="() => _newGroupColor = c"
                                    class="w-8 h-8 rounded-full border-2 transition-all @c.Active @(_newGroupColor?.Label == c.Label ? "ring-4 ring-indigo-500/20 scale-110 border-white shadow-md" : "border-transparent opacity-60")">
                            </button>
                        }
                    </div>
                    <div class="flex gap-3">
                        @if (_editingGroupId is not null)
                        {
                            <button type="button" @onclick="ResetGroupForm" class="w-1/3 bg-slate-200 text-slate-600 font-black py-4 rounded-2xl shadow-sm active:scale-95">取消</button>
                        }
                        <button disabled="@(_isSavingGroup || string.IsNullOrWhiteSpace(_newGroupName))" type="submit"
                                class="flex-1 bg-slate-900 text-white font-black py-4 rounded-2xl shadow-lg active:scale-95 flex items-center justify-center gap-2 disabled:bg-slate-300 disabled:shadow-none">
                            @if (_isSavingGroup) { <LucideIcon Name="loader-2" Class="w-4 h-4 animate-spin" /> }
                            else { @(_editingGroupId is not null ? "儲存修改" : "新增小組成員") }
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ── Delete Confirm ───────────────────────────────────────────────────────── *@
@if (_taskToDelete is not null)
{
    <div class="fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm"
         @onclick="() => _taskToDelete = null">
        <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-sm overflow-hidden shadow-slate-900/50" @onclick:stopPropagation="true">
            <div class="p-8 text-center">
                <div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-4 border border-rose-100">
                    <LucideIcon Name="alert-triangle" Class="w-8 h-8" />
                </div>
                <h3 class="text-xl font-black text-slate-900 mb-2 tracking-tight">確定要刪除嗎？</h3>
                <p class="text-sm font-bold text-slate-400 px-4">「@_taskToDelete.Title」<br />刪除後將無法恢復。</p>
            </div>
            <div class="p-6 bg-slate-50 flex gap-3">
                <button @onclick="() => _taskToDelete = null" class="flex-1 py-3 rounded-xl font-black text-slate-500 bg-white border border-slate-200 transition-all hover:bg-slate-100">取消</button>
                <button @onclick="() => HandleDeleteTask(_taskToDelete)" class="flex-1 py-3 rounded-xl font-black text-white bg-rose-500 transition-all active:scale-95 shadow-lg shadow-rose-200">確認刪除</button>
            </div>
        </div>
    </div>
}

@* ── Image Lightbox ───────────────────────────────────────────────────────── *@
@if (_previewImage is not null)
{
    <div class="fixed inset-0 z-[300] flex items-center justify-center p-4 bg-slate-900/90 backdrop-blur-md"
         @onclick="() => _previewImage = null">
        <button @onclick="() => _previewImage = null" class="absolute top-6 right-6 p-2 text-white/50 hover:text-white transition-colors">
            <LucideIcon Name="x" Class="w-8 h-8" />
        </button>
        <img src="@_previewImage" alt="預覽圖片" class="max-w-full max-h-full rounded-lg shadow-2xl" @onclick:stopPropagation="true" />
    </div>
}
