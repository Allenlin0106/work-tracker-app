@using WorkTracker.Client.Services
@using WorkTracker.Client.Models
@using Microsoft.AspNetCore.Components.Forms

@if (Task is not null)
{
    var (dLabel, dColor, dIcon) = TaskHelpers.GetTaskStatus(Task, AppState.Logs);
    var validTagsD = Task.Tags.Where(tName => AppState.Tags.Any(t => t.Name == tName)).ToList();

    <div class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md"
         @onclick="OnClose">
        <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-6xl flex flex-col md:flex-row max-h-[90vh] overflow-hidden shadow-slate-900/30"
             @onclick:stopPropagation="true">

            @* Left panel — checklist + attachments *@
            <div class="flex-1 flex flex-col border-r border-slate-100 p-12 overflow-y-auto scrollbar-thin">
                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-4">
                        <span class="px-5 py-2 rounded-full text-xs font-black border @dColor">@dLabel</span>
                        <RecurrenceBadge Task="@Task" />
                        @if (validTagsD.Count > 0)
                        {
                            <div class="flex items-center gap-2 ml-2 pl-3 border-l border-slate-200">
                                @foreach (var tName in validTagsD)
                                {
                                    var tObj  = AppState.Tags.FirstOrDefault(t => t.Name == tName);
                                    var cObj  = tObj?.Color;
                                    <span class="flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-black uppercase tracking-widest border @(cObj?.Bg ?? "bg-slate-100") @(cObj?.Text ?? "text-slate-400") @(cObj?.Border ?? "border-slate-200")">
                                        @tName
                                        <button @onclick="() => HandleRemoveTagFromTask(tName)"
                                                class="hover:text-rose-500 transition-colors opacity-50 hover:opacity-100 p-0.5 ml-0.5 bg-white/50 hover:bg-white rounded-full">
                                            <LucideIcon Name="x" Class="w-3 h-3" />
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <h3 class="text-4xl font-black text-slate-900 leading-tight uppercase tracking-tight">@Task.Title</h3>
                    <div class="flex flex-col gap-3 mt-4 bg-slate-50 px-5 py-4 rounded-xl border border-slate-100 w-full md:w-fit">
                        <div class="flex flex-wrap items-center gap-2">
                            <div class="flex items-center gap-2 text-sm font-black text-slate-400 uppercase tracking-widest shrink-0">
                                <LucideIcon Name="calendar-days" Class="w-5 h-5" /> 計畫時程：
                            </div>
                            <div class="text-base font-black text-slate-700 whitespace-nowrap">@Task.StartDate <span class="mx-2 text-slate-300">→</span> @Task.EndDate</div>
                        </div>
                        <div class="flex flex-wrap items-start gap-2">
                            <div class="flex items-center gap-2 text-sm font-black text-slate-400 uppercase tracking-widest shrink-0 mt-0.5">
                                <LucideIcon Name="user" Class="w-5 h-5" /> 負責人員：
                            </div>
                            <div class="text-base font-black text-slate-700 leading-relaxed">@TaskHelpers.DisplayAssignee(Task.Assignee)</div>
                        </div>
                    </div>
                </div>

                @* Attachments *@
                <div class="mb-10">
                    <div class="mb-6 flex items-center justify-between">
                        <h4 class="text-lg font-black text-slate-900 flex items-center gap-3 tracking-tight">
                            <LucideIcon Name="paperclip" Class="w-6 h-6 text-indigo-500" /> 附件與相關網址
                        </h4>
                    </div>
                    @if (Task.Attachments.Count > 0)
                    {
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                            @foreach (var att in Task.Attachments)
                            {
                                <div class="relative group">
                                    @if (att.Type == "image")
                                    {
                                        <button @onclick="() => _previewImage = att.Url"
                                                class="block w-full h-full relative rounded-xl overflow-hidden border border-slate-200 aspect-video bg-slate-100 shadow-sm hover:shadow-md transition-all text-left">
                                            <img src="@att.Url" alt="@att.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                            <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-sm">
                                                <LucideIcon Name="search" Class="w-6 h-6 text-white" />
                                            </div>
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="@att.Url" target="_blank" rel="noopener noreferrer"
                                           class="flex items-center gap-3 p-3 bg-white border border-slate-200 rounded-xl hover:border-indigo-300 hover:shadow-md transition-all h-full">
                                            <div class="p-2 bg-indigo-50 rounded-lg group-hover:bg-indigo-100 transition-colors">
                                                <LucideIcon Name="link" Class="w-5 h-5 text-indigo-500" />
                                            </div>
                                            <div class="overflow-hidden flex-1">
                                                <p class="text-sm font-bold text-slate-700 truncate">@att.Name</p>
                                                <p class="text-[10px] text-slate-400 truncate mt-0.5">@att.Url</p>
                                            </div>
                                        </a>
                                    }
                                    <button @onclick="() => HandleDetailDeleteAttachment(att.Id)"
                                            class="absolute -top-2 -right-2 bg-white border border-slate-200 text-slate-400 hover:text-rose-500 hover:border-rose-200 p-1.5 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-all z-10">
                                        <LucideIcon Name="trash-2" Class="w-3.5 h-3.5" />
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    <div class="p-6 bg-slate-50 rounded-3xl border border-slate-200 shadow-inner space-y-4">
                        <div class="flex gap-2 items-center">
                            <input type="text" placeholder="顯示名稱 (選填)" class="w-1/3 p-3 bg-white border border-slate-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-100"
                                   @bind="_detailLinkName" />
                            <input type="text" placeholder="網址 https://..." class="flex-1 p-3 bg-white border border-slate-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-100"
                                   @bind="_detailLinkUrl"
                                   @onkeydown='async e => { if (e.Key == "Enter") await HandleDetailAddLink(); }' />
                            <button @onclick="HandleDetailAddLink"
                                    class="px-5 py-3 bg-slate-900 text-white rounded-xl font-black shadow-md hover:bg-slate-800 transition-all text-sm whitespace-nowrap">新增連結</button>
                        </div>
                        <div class="flex items-center gap-4 pt-2">
                            <label class="flex items-center gap-2 px-5 py-3 bg-white border border-slate-200 rounded-xl text-sm font-black text-slate-600 cursor-pointer hover:bg-slate-100 transition-colors shadow-sm">
                                <LucideIcon Name="upload" Class="w-4 h-4 text-indigo-500" /> 上傳電腦圖片
                                <InputFile OnChange="HandleImageUpload" accept="image/*" class="hidden" />
                            </label>
                            <span class="text-[10px] font-bold text-slate-400">支援影像格式。系統將自動最佳化並壓縮影像尺寸。</span>
                        </div>
                    </div>
                </div>

                @* Checklist *@
                <div class="mb-6 flex items-center justify-between">
                    <h4 class="text-lg font-black text-slate-900 flex items-center gap-3 tracking-tight">
                        <LucideIcon Name="check-square" Class="w-6 h-6 text-indigo-500" /> 工作分解項目
                    </h4>
                </div>

                @if (_showRecurConfirm)
                {
                    <div class="mb-6 p-5 bg-indigo-50 rounded-2xl border-2 border-indigo-500 animate-pulse flex items-center justify-between shadow-lg">
                        <p class="text-xs font-black text-indigo-700">任務已 100% 完成！是否要以此為基準複刻下期任務？</p>
                        <div class="flex gap-2">
                            <button disabled="@_isRecurProcessing" @onclick="ExecuteRecurrence"
                                    class="bg-indigo-600 text-white px-5 py-2 rounded-xl text-[10px] font-black hover:bg-indigo-700 shadow-md">確認複刻</button>
                            <button @onclick="() => _showRecurConfirm = false"
                                    class="bg-white border border-indigo-200 text-indigo-400 px-5 py-2 rounded-xl text-[10px] font-black">先不複刻</button>
                        </div>
                    </div>
                }

                <div class="space-y-4 mb-10">
                    @foreach (var item in Task.Checklist)
                    {
                        <div class="flex items-center gap-5 p-5 bg-slate-50 rounded-2xl group border border-transparent hover:border-indigo-100 hover:bg-white shadow-sm transition-all">
                            <button @onclick="() => ToggleChecklistItem(item)" class="shrink-0 active:scale-75 transition-transform">
                                @if (item.Completed)
                                { <LucideIcon Name="check-circle-2" Class="w-8 h-8 text-emerald-500" /> }
                                else
                                { <LucideIcon Name="square" Class="w-8 h-8 text-slate-300" /> }
                            </button>
                            <div class="flex flex-col flex-1">
                                <span class="text-base font-bold @(item.Completed ? "text-slate-400 line-through" : "text-slate-700")">@item.Text</span>
                                <div class="flex items-center gap-4 mt-1.5">
                                    <span class="text-xs font-black text-slate-400 uppercase tracking-tighter">期限：@item.StartDate ~ @item.DueDate</span>
                                    @if (item.Completed && item.ActualDoneDate is not null)
                                    {
                                        <span class="flex items-center gap-2 text-xs font-black text-emerald-500 bg-emerald-50 px-2 py-1 rounded border border-emerald-100">
                                            <LucideIcon Name="clock" Class="w-3 h-3" /> 完成於 @item.ActualDoneDate
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="flex items-center gap-1 text-slate-300">
                                <button @onclick="() => { _editingChecklistId = item.Id.ToString(); _newChecklistItem = item.Text; _newChecklistStartDate = item.StartDate ?? Task.StartDate ?? TaskHelpers.FormatDate(DateTime.Today); _newChecklistEndDate = item.DueDate ?? Task.EndDate ?? TaskHelpers.FormatDate(DateTime.Today); }"
                                        class="hover:text-indigo-600 p-2.5 transition-all">
                                    <LucideIcon Name="pencil" Class="w-5 h-5" />
                                </button>
                                <button @onclick="() => DeleteChecklistItem(item.Id)"
                                        class="hover:text-rose-500 p-2.5 transition-all">
                                    <LucideIcon Name="x" Class="w-5 h-5" />
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-8 rounded-3xl border shadow-inner transition-colors @(_editingChecklistId is not null ? "bg-indigo-50/50 border-indigo-200" : "bg-slate-50 border-slate-200")">
                    @if (_editingChecklistId is not null)
                    {
                        <div class="flex items-center justify-between mb-4 bg-white px-4 py-2 rounded-xl border border-indigo-100 shadow-sm">
                            <span class="text-xs font-black text-indigo-600 uppercase flex items-center gap-2">
                                <LucideIcon Name="pencil" Class="w-4 h-4" /> 正在編輯分解項目...
                            </span>
                            <button @onclick="() => { _editingChecklistId = null; _newChecklistItem = string.Empty; }" class="text-slate-400 hover:text-rose-500 transition-colors p-1">
                                <LucideIcon Name="x" Class="w-4 h-4" />
                            </button>
                        </div>
                    }
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div class="flex flex-col">
                            <label class="text-xs font-black text-slate-400 mb-2 uppercase tracking-widest">子項開始</label>
                            <input type="date" class="bg-white px-4 py-3 rounded-xl text-sm font-bold border border-slate-200 focus:ring-4 focus:ring-indigo-100"
                                   @bind="ChecklistStart" />
                        </div>
                        <div class="flex flex-col">
                            <label class="text-[10px] font-black text-slate-400 mb-2 uppercase tracking-widest">子項截止</label>
                            <input type="date" class="bg-white px-4 py-3 rounded-xl text-sm font-bold border border-slate-200 focus:ring-4 focus:ring-indigo-100"
                                   @bind="ChecklistEnd" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_checklistError))
                    { <p class="text-xs text-rose-500 mb-2 font-bold">@_checklistError</p> }
                    <div class="flex gap-3 relative">
                        <input type="text" placeholder="描述細項內容..."
                               class="flex-1 bg-white px-5 py-4 rounded-xl text-base font-bold outline-none border border-slate-200 focus:ring-4 focus:ring-indigo-100 transition-all"
                               @bind="_newChecklistItem"
                               @onkeydown='async e => { if (e.Key == "Enter") await HandleAddChecklistItem(); }' />
                        <button @onclick="HandleAddChecklistItem"
                                class="@(_editingChecklistId is not null ? "bg-indigo-600 hover:bg-indigo-700" : "bg-slate-900 hover:bg-slate-800") text-white px-6 rounded-xl active:scale-95 transition-all shadow-md flex items-center justify-center font-black">
                            @if (_editingChecklistId is not null) { @("儲存") } else { <LucideIcon Name="plus" Class="w-6 h-6" /> }
                        </button>
                    </div>
                </div>
            </div>

            @* Right panel — logs *@
            <div class="w-full md:w-[420px] bg-slate-50/50 flex flex-col p-10 overflow-hidden border-l border-slate-100 shadow-inner">
                <h4 class="text-lg font-black mb-8 flex items-center gap-3 tracking-tight">
                    <LucideIcon Name="message-square" Class="w-6 h-6 text-indigo-400" /> 進度日誌
                </h4>
                <div class="flex-1 overflow-y-auto space-y-5 mb-8 scrollbar-thin">
                    @foreach (var log in AppState.Logs.Where(l => l.TaskId == Task.Id)
                                         .OrderByDescending(l => TaskHelpers.TryParseTimestamp(l.Timestamp) ?? DateTime.MinValue))
                    {
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 group/log relative shadow-slate-200/40">
                            <p class="text-sm text-slate-600 leading-relaxed font-medium whitespace-pre-wrap">@log.Text</p>
                            <div class="flex items-center justify-between mt-3">
                                <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">
                                    @(log.Timestamp is not null ? DateTime.Parse(log.Timestamp).ToShortDateString() : "傳送中")
                                    @(log.UpdatedAt is not null ? " (已編輯)" : "")
                                </span>
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => { _editingLogId = log.Id; _newLogText = log.Text; }"
                                            class="opacity-0 group-hover/log:opacity-100 p-1.5 text-slate-300 hover:text-indigo-600 transition-all">
                                        <LucideIcon Name="pencil" Class="w-4 h-4" />
                                    </button>
                                    <button @onclick="() => HandleDeleteLog(log.Id)"
                                            class="opacity-0 group-hover/log:opacity-100 p-1.5 text-slate-300 hover:text-rose-500 transition-all">
                                        <LucideIcon Name="trash-2" Class="w-4 h-4" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="flex flex-col gap-3 p-3 bg-white rounded-2xl border @(_editingLogId is not null ? "border-indigo-400 ring-4 ring-indigo-50 shadow-lg" : "border-slate-200 shadow-sm")">
                    @if (_editingLogId is not null)
                    {
                        <div class="flex items-center justify-between px-3 py-1.5 bg-indigo-50 rounded-lg">
                            <span class="text-xs font-black text-indigo-600 uppercase">正在編輯日誌...</span>
                            <button @onclick="() => { _editingLogId = null; _newLogText = string.Empty; }" class="text-indigo-400 hover:text-rose-500">
                                <LucideIcon Name="x" Class="w-3 h-3" />
                            </button>
                        </div>
                    }
                    <div class="flex gap-3">
                        <textarea rows="2" placeholder="撰寫回報..."
                                  class="flex-1 px-4 py-3 bg-transparent text-sm font-bold outline-none resize-none"
                                  @bind="_newLogText" @bind:event="oninput"
                                  @onkeydown='async e => { if (e.Key == "Enter" && !e.ShiftKey) { await HandleSendLog(); } }'></textarea>
                        <button @onclick="HandleSendLog"
                                class="px-5 rounded-xl active:scale-90 transition-all shadow-lg self-end mb-1 mr-1 py-4 @(_editingLogId is not null ? "bg-indigo-600 text-white" : "bg-slate-900 text-white")">
                            @if (_editingLogId is not null) { <LucideIcon Name="check-circle" Class="w-6 h-6" /> }
                            else { <LucideIcon Name="send" Class="w-6 h-6" /> }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Image lightbox *@
    @if (_previewImage is not null)
    {
        <div class="fixed inset-0 z-[300] flex items-center justify-center p-4 bg-slate-900/90 backdrop-blur-md"
             @onclick="() => _previewImage = null">
            <button @onclick="() => _previewImage = null" class="absolute top-6 right-6 p-2 text-white/50 hover:text-white transition-colors">
                <LucideIcon Name="x" Class="w-8 h-8" />
            </button>
            <img src="@_previewImage" alt="預覽圖片" class="max-w-full max-h-full rounded-lg shadow-2xl" @onclick:stopPropagation="true" />
        </div>
    }
}
