@inject AuthService Auth

@if (_loading)
{
    <div class="h-screen flex items-center justify-center bg-slate-50 font-black text-indigo-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 animate-spin mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        安全連線初始化中...
    </div>
}
else if (Auth.IsAuthenticated)
{
    <Pages.MainPage />
}
else
{
    <Pages.AuthPage OnAuthenticated="HandleAuthenticated" />
}

@code {
    private bool _loading = true;

    protected override void OnInitialized()
    {
        Auth.OnChange += () => InvokeAsync(StateHasChanged);
        _loading = false;
    }

    private void HandleAuthenticated()
    {
        StateHasChanged();
    }
}
