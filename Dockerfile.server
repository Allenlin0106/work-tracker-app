# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/WorkTracker/WorkTracker.csproj WorkTracker/
COPY backend/WorkTracker.Client/WorkTracker.Client.csproj WorkTracker.Client/
RUN dotnet restore WorkTracker/WorkTracker.csproj
COPY backend/WorkTracker/ WorkTracker/
COPY backend/WorkTracker.Client/ WorkTracker.Client/
RUN dotnet publish WorkTracker/WorkTracker.csproj -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 80
ENTRYPOINT ["dotnet", "WorkTracker.dll"]
